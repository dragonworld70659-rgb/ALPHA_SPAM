# Telegram API values from https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash

# Bot token from @BotFather
BOT_TOKEN=123456:ABCDEF_your_bot_token

# Pyrogram string session for assistant account (must be in your group and admin)
STRING_SESSION=

# Optional admin IDs / command prefixes
SUDO_USERS=123456789 987654321
COMMAND_PREFIXES=/ ! .

# Advanced AI features (chat + summarize + image generation)
OPENAI_API_KEY=sk-your_openai_api_key_here
AI_MODEL=gpt-4.1-mini
AI_IMAGE_MODEL=gpt-image-1
