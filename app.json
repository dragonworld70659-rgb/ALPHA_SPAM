{
  "name": "Telegram Music Bot",
  "description": "Simple Telegram VC Music Bot (Pyrogram + PyTgCalls)",
  "logo": "https://raw.githubusercontent.com/heroku/node-js-getting-started/main/public/node.svg",
  "keywords": [
    "telegram",
    "music",
    "pyrogram",
    "pytgcalls",
    "heroku"
  ],
  "repository": "https://github.com/yourusername/your-music-bot",
  "env": {
    "API_ID": {
      "description": "Telegram API_ID",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API_HASH",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Bot token from @BotFather",
      "required": true
    },
    "STRING_SESSION": {
      "description": "Assistant account string session",
      "required": true
    },
    "SUDO_USERS": {
      "description": "Space-separated user IDs",
      "required": false
    },
    "COMMAND_PREFIXES": {
      "description": "Prefixes e.g. / ! .",
      "required": false,
      "value": "/ ! ."
    },
    "OPENAI_API_KEY": {
      "description": "OpenAI API key for AI commands",
      "required": false
    },
    "AI_MODEL": {
      "description": "Chat model id",
      "required": false,
      "value": "gpt-4.1-mini"
    },
    "AI_IMAGE_MODEL": {
      "description": "Image model id",
      "required": false,
      "value": "gpt-image-1"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
